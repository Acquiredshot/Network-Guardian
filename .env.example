# Network Guardian — Environment Configuration Example
# Copy this file to .env and fill in your actual values

# OpenRouter API Key (for Email Scanner v2 AI analysis)
OPENROUTER_API_KEY=your-api-key-here

# Optional: Override default model
OPENROUTER_MODEL=gpt-oss-120b

# ── DeepSeek AI (Jarvis triage + LangGraph reasoner) ──────────────
# Get your key at: https://platform.deepseek.com/api_keys
# Enables: 'triage', 'analyze', 'deep scan' commands in Jarvis
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Optional: DeepSeek model override (default is deepseek-reasoner)
# DEEPSEEK_MODEL=deepseek-reasoner
