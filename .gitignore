# SQLite databases (may contain sensitive scan results)
*.db
network_guardian.db

# API keys and credentials
*_api_key.txt
*_credentials.json

# Standalone probe — contains live fleet key, distribute directly to team members only
# NEVER push to a public repo
ng_probe_standalone.py

# Documentation — company internal knowledge only, never push to GitHub
documentation/

# Member setup files — contain usernames/role info, keep off GitHub
PROBE_SETUP_*.md

# Local incident reports (sensitive)
INCIDENT_REPORT_*.md
incident_reports/*.md
!incident_reports/INCIDENT_REPORT_2026-04-13.md

# Runtime data — contains hashed passwords and access logs
users_db.json
access_log.json

# JARVIS runtime logs (may contain operator commands and probe IPs)
jarvis_crash.log
jarvis_*.log

# Agent auth token (contains time-limited fleet credentials)
.ng_agent/
.ng_agent_auth.json

# Network Guardian runtime data dir (fleet.json, baselines, injection db)
.network_guardian/

# Fleet key and agent registration keys (never push — distribute out-of-band)
fleet_key.txt
agent_key.txt
*_agent_key.txt

# Heroku / deployment secrets
.heroku/
Procfile.local

# Local config overrides (may contain private IPs, passwords)
config.local.yaml
config.override.yaml

# Business & test documents (internal use only)
BUSINESS_REQUIREMENTS_DOCUMENT.md
FUNCTIONALITY_TEST_REPORT.md
*_TEST_REPORT.md
PRICING_TIER_MATRIX.txt

# Local scan artefacts — generated at runtime, not source
pdf_reports/
.network_guardian_scan/

# Scan/export data — contains network topology, attacker IPs, firewall rules (sensitive)
export/

# pywin32 / COM / SAPI generated cache
win32com/
win32/

# Crash / core dumps
*.dmp
crash_*.txt
